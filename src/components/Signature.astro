---
// Animated signature — Daniel Oliver's real autograph, traced to a single SVG
// centreline path from a scan. The path is drawn on with stroke-dasharray so it
// looks like it's being written (left-to-right, since the sub-strokes are
// ordered by x). Replayable: re-runs on view-transition swaps (used by the
// persistent header sig) and can loop periodically as a "living" mark.
// No-JS / prefers-reduced-motion fall back to the fully-drawn signature.
import sig from '../data/signature.json';

interface Props {
  animate?: boolean;
  class?: string;
  /** 'cinematic' (hero, slower hand) | 'quick' (header, ~1.1s) */
  speed?: 'cinematic' | 'quick';
  /** 'gradient' (pink→violet→cyan) | 'mono' (white) */
  tone?: 'gradient' | 'mono';
  glow?: boolean;
  /** re-write itself periodically while visible */
  loop?: boolean;
}
const {
  animate = false,
  class: className = '',
  speed = 'cinematic',
  tone = 'gradient',
  glow = false,
  loop = false,
} = Astro.props;

const gid = `sig-grad-${Math.random().toString(36).slice(2, 8)}`;
const [tx, ty] = sig.translate as [number, number];
const stroke = tone === 'mono' ? '#fff' : `url(#${gid})`;
---
<svg
  class={`signature ${glow ? 'sig-glow' : ''} ${className}`}
  viewBox={sig.viewBox}
  role="img"
  aria-label="Daniel Oliver signature"
  fill="none"
  data-sig-animate={animate ? 'true' : undefined}
  data-sig-speed={speed}
  data-sig-loop={loop ? 'true' : undefined}
  xmlns="http://www.w3.org/2000/svg"
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2={sig.viewBox.split(' ')[2]} y2="0" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#ff2d87" />
      <stop offset="0.5" stop-color="#8b5cf6" />
      <stop offset="1" stop-color="#38bdf8" />
    </linearGradient>
  </defs>
  <g transform={`translate(${tx}, ${ty})`}>
    <path
      class="sig-path"
      d={sig.d}
      stroke={stroke}
      stroke-width="6.5"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </g>
</svg>

<style>
  /* Animatable reveal edge (left → right). @property lets us transition a
     custom property used inside the mask gradient. */
  @property --sig-reveal {
    syntax: '<number>';
    inherits: true;
    initial-value: 120;
  }
  .signature {
    display: block;
    overflow: visible;
    /* Soft-edged left-to-right ink reveal: everything left of the edge is
       opaque, a ~7% band fades to transparent = the "wet pen tip". */
    --sig-reveal: 120; /* default: fully written */
    -webkit-mask-image: linear-gradient(90deg, #000 calc(var(--sig-reveal) * 1%), transparent calc((var(--sig-reveal) + 7) * 1%));
    mask-image: linear-gradient(90deg, #000 calc(var(--sig-reveal) * 1%), transparent calc((var(--sig-reveal) + 7) * 1%));
  }
  /* Animated instances start un-written; JS animates the edge across. */
  .signature[data-sig-animate] { --sig-reveal: -8; }
  /* No-JS: show the finished signature (can't animate a custom prop). */
  @media (scripting: none) {
    .signature { --sig-reveal: 120 !important; }
  }
  .sig-path { stroke-width: 6.5; }

  /* Soft brand glow that breathes, so the mark never reads as static. */
  .sig-glow {
    filter: drop-shadow(0 0 20px #8b5cf655) drop-shadow(0 0 7px #ff2d8733);
    animation: sig-breathe 5.5s ease-in-out infinite alternate;
  }
  @keyframes sig-breathe {
    from { filter: drop-shadow(0 0 14px #8b5cf640) drop-shadow(0 0 5px #ff2d8726); }
    to   { filter: drop-shadow(0 0 28px #8b5cf680) drop-shadow(0 0 11px #ff2d8755) drop-shadow(0 0 34px #38bdf826); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sig-glow { animation: none; }
    .signature { --sig-reveal: 120 !important; } /* fully written, no motion */
  }
</style>

<script>
  const reduce = () =>
    window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Play (or replay) the left-to-right "being written" reveal.
  function playSignature(svg: SVGSVGElement) {
    if (reduce()) {
      svg.style.setProperty('--sig-reveal', '120');
      return;
    }
    const quick = svg.dataset.sigSpeed === 'quick';
    const dur = quick ? 1.4 : 2.6; // seconds — the "hand speed"

    // Reset to fully un-written (edge off the left), no transition.
    svg.style.transition = 'none';
    svg.style.setProperty('--sig-reveal', '-8');
    // Force reflow so the reset applies before animating forward.
    svg.getBoundingClientRect();
    svg.style.transition = `--sig-reveal ${dur}s cubic-bezier(0.65, 0, 0.35, 1)`;
    svg.style.setProperty('--sig-reveal', '120');
  }

  // Draw every animating signature now (called on load + after swaps).
  function initSignatures() {
    document
      .querySelectorAll<SVGSVGElement>('svg.signature[data-sig-animate]')
      .forEach(playSignature);
  }

  // Expose replay for the persistent header signature (re-writes on each nav).
  (window as any).__replaySignature = (svg: SVGSVGElement) => {
    if (svg) playSignature(svg);
  };

  // ---- Living signatures: re-write [data-sig-loop] instances periodically
  // while on screen (tab visible, motion allowed). One shared timer + observer.
  let loopTimer: number | undefined;
  let loopIO: IntersectionObserver | undefined;
  const visible = new Set<SVGSVGElement>();

  function initSignatureLoop() {
    if (loopTimer) { clearInterval(loopTimer); loopTimer = undefined; }
    loopIO?.disconnect();
    visible.clear();
    if (reduce()) return;

    const loopers = document.querySelectorAll<SVGSVGElement>(
      'svg.signature[data-sig-loop]'
    );
    if (!loopers.length) return;

    loopIO = new IntersectionObserver(
      (entries) =>
        entries.forEach((e) => {
          const svg = e.target as SVGSVGElement;
          if (e.isIntersecting) visible.add(svg);
          else visible.delete(svg);
        }),
      { threshold: 0.4 }
    );
    loopers.forEach((svg) => loopIO!.observe(svg));

    loopTimer = window.setInterval(() => {
      if (document.hidden || reduce()) return;
      visible.forEach(playSignature);
    }, 11000);
  }

  function boot() {
    initSignatures();
    initSignatureLoop();
  }

  document.addEventListener('astro:page-load', boot);
</script>
