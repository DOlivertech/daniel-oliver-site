---
import Signature from './Signature.astro';
import SocialLinks from './SocialLinks.astro';
import site from '../data/site.json';

const year = new Date().getFullYear();
const nav = (site.nav as { label: string; href: string; external?: boolean }[]).filter((l) => !l.external);
const f = site.footer;
---
<footer class="relative mt-28 border-t border-white/5 bg-ink-2/60">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px" style="background: var(--grad-accent); opacity: 0.5;" aria-hidden="true"></div>

  <!-- Sponsor home: curated logo grid -->
  <section class="mx-auto max-w-6xl px-6 pt-20 pb-14" aria-labelledby="partners-heading">
    <div class="mb-10 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow mb-3">{f.partnersEyebrow}</p>
        <h2 id="partners-heading" class="h-display text-3xl text-white sm:text-4xl">{f.partnersHeadingPrefix} <span class="text-gradient">{f.partnersHeadingAccent}</span></h2>
      </div>
      <a href={f.partnersCtaHref} class="btn btn-ghost shrink-0">{f.partnersCtaLabel}
        <svg class="h-4 w-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      </a>
    </div>

    <ul class="grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
      {site.sponsors.map((s) => (
        <li class="bg-ink-2">
          <a
            href={s.url}
            class="group flex h-28 items-center justify-center p-6 transition-colors duration-300 hover:bg-ink-3 sm:h-32"
            aria-label={s.name}
            {...(s.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <img
              src={s.logo}
              alt={`${s.name} logo`}
              loading="lazy"
              width="220"
              height="80"
              class="max-h-14 w-auto max-w-[10.5rem] object-contain opacity-70 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:opacity-100 sm:max-h-16"
            />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <div class="mx-auto max-w-6xl px-6 pb-10">
    <div class="rule-gradient opacity-30"></div>

    <div class="flex flex-col gap-10 py-12 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <img
          src={site.brand.wordmarkLaser}
          alt={`${site.name} ${site.number} wordmark`}
          width="1500"
          height="844"
          class="-my-8 h-40 w-auto max-w-full object-contain sm:-my-10 sm:h-48"
          loading="lazy"
        />
        <Signature animate glow loop tone="gradient" class="mb-4 w-64 sm:w-72" />
        <p class="text-sm leading-relaxed text-mist">
          {f.blurbPrefix} <span class="text-pink font-semibold">{f.blurbNumber}</span> {f.blurbSuffix}
        </p>
        <p class="mt-3 font-mono text-[0.62rem] uppercase tracking-[0.3em] text-fog">{f.taglinePrefix} <span class="text-gradient font-bold">{f.taglineAccent}</span></p>
      </div>

      <nav aria-label="Footer navigation" class="grid grid-cols-2 gap-x-12 gap-y-3">
        {nav.map((l) => (
          <a href={l.href} class="text-sm text-fog transition-colors hover:text-white">{l.label}</a>
        ))}
        <a href={site.storeUrl} target="_blank" rel="noopener noreferrer" class="text-sm text-fog transition-colors hover:text-white">{f.storeLabel}</a>
      </nav>

      <div>
        <p class="eyebrow mb-4">{f.followLabel}</p>
        <SocialLinks />
        <a href={`mailto:${site.email}`} class="mt-5 block font-mono text-xs text-mist transition-colors hover:text-cyan">{site.email}</a>
      </div>
    </div>

    <div class="flex flex-col items-start justify-between gap-3 border-t border-white/5 pt-6 text-xs text-mist sm:flex-row sm:items-center">
      <p>© {year} {f.copyright}</p>
      <p class="font-mono tracking-[0.25em]">{f.motto}</p>
    </div>
  </div>
</footer>
