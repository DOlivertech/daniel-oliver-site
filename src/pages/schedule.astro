---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/schedule.json';

const events = await getCollection('events');
const upcoming = events
  .filter((e) => e.data.status === 'upcoming')
  .sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
const past = events
  .filter((e) => e.data.status === 'completed')
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const next = upcoming[0];

const fmt = (d: Date) =>
  d.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
const isTBA = (e: (typeof events)[number]) => Boolean(e.data.dateLabel?.includes('TBA'));

// Classify a result string into a podium tier for medal styling.
const podium = (r?: string): 'gold' | 'silver' | 'bronze' | null => {
  if (!r) return null;
  const s = r.toLowerCase();
  if (/(^|[^0-9])(p ?1|1st|first|win|won|victory|🥇)([^0-9]|$)/.test(s)) return 'gold';
  if (/(^|[^0-9])(p ?2|2nd|second|🥈)([^0-9]|$)/.test(s)) return 'silver';
  if (/(^|[^0-9])(p ?3|3rd|third|🥉)([^0-9]|$)/.test(s)) return 'bronze';
  return null;
};
const tierStyle: Record<string, string> = {
  gold: 'bg-[#fbbf24]/12 text-[#fcd34d] border-[#fbbf24]/35',
  silver: 'bg-[#cbd5e1]/12 text-[#e2e8f0] border-[#cbd5e1]/35',
  bronze: 'bg-[#fb923c]/12 text-[#fdba74] border-[#fb923c]/35',
};
const hasResult = (r?: string) => Boolean(r && r.trim() && r.trim() !== '—');

const cd = page.countdownLabels;
const countdownUnits = [
  { key: 'days', label: cd.days },
  { key: 'hours', label: cd.hours },
  { key: 'mins', label: cd.mins },
  { key: 'secs', label: cd.secs },
];
---
<BaseLayout title={page.meta.title} description={page.meta.description}>
  <section class="px-6 pb-14 pt-40 sm:px-12 lg:px-20">
    <p class="eyebrow reveal mb-4">{page.hero.eyebrow}</p>
    <h1 class="h-display reveal text-[clamp(2.6rem,7vw,5.5rem)] uppercase text-white" style="--reveal-delay:100ms">
      {page.hero.titlePrefix} <span class="text-gradient">{page.hero.titleAccent}</span>
    </h1>
    <p class="reveal mt-6 max-w-2xl text-lg text-fog" style="--reveal-delay:200ms">
      {page.hero.intro}
    </p>
  </section>

  <!-- Next event + countdown -->
  {next && (
    <section class="mx-auto max-w-6xl px-6 pb-16">
      <div class="grad-border reveal relative overflow-hidden rounded-3xl p-8 sm:p-12">
        <div class="pointer-events-none absolute inset-0 opacity-40" style="background: radial-gradient(ellipse 55% 90% at 85% 20%, #ff2d8730, transparent 65%), radial-gradient(ellipse 50% 80% at 10% 90%, #38bdf825, transparent 65%);" aria-hidden="true"></div>
        <div class="relative">
          <p class="eyebrow mb-4">{page.next.eyebrow}</p>
          <h2 class="h-display max-w-3xl text-3xl text-white sm:text-5xl">{next.data.title}</h2>
          <p class="mt-4 font-mono text-sm text-mist">
            {next.data.circuit} · {next.data.location} · <span class="text-cyan">{next.data.dateLabel ?? fmt(next.data.date)}</span>
          </p>

          <div
            id="countdown"
            class="mt-10 grid max-w-xl grid-cols-4 gap-3 sm:gap-4"
            data-date={next.data.date.toISOString()}
            data-tba={isTBA(next) ? 'true' : 'false'}
            role="timer"
            aria-label="Countdown to next race"
          >
            {countdownUnits.map((u) => (
              <div class="rounded-2xl border border-line bg-ink/60 px-2 py-5 text-center backdrop-blur">
                <span class="cd-value block font-display text-2xl font-bold text-gradient sm:text-4xl" data-unit={u.key}>–</span>
                <span class="mt-2 block font-mono text-[0.6rem] uppercase tracking-[0.25em] text-mist">{u.label}</span>
              </div>
            ))}
          </div>
          <p id="countdown-note" class="mt-4 hidden font-mono text-xs tracking-[0.2em] text-mist">{page.next.tbaNote}</p>
        </div>
      </div>
    </section>
  )}

  <!-- Upcoming list -->
  <section class="mx-auto max-w-6xl px-6 pb-8">
    <h2 class="h-display reveal mb-8 text-2xl text-white sm:text-3xl">{page.upcoming.titlePrefix} <span class="text-gradient">{page.upcoming.titleAccent}</span></h2>
    <ol class="space-y-4">
      {upcoming.map((e, i) => (
        <li class="card reveal flex flex-col gap-4 px-7 py-6 sm:flex-row sm:items-center sm:justify-between" style={`--reveal-delay:${i * 90}ms`}>
          <div class="flex items-center gap-5">
            <span class="font-mono text-xs tracking-[0.3em] text-cyan">R{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="font-display text-base font-bold text-white sm:text-lg">{e.data.title}</h3>
              <p class="mt-1 font-mono text-xs text-mist">{e.data.circuit} · {e.data.location} · {e.data.series}</p>
            </div>
          </div>
          <span class="shrink-0 rounded-full border border-violet/40 bg-violet/10 px-4 py-2 font-mono text-xs tracking-widest text-white">
            {e.data.dateLabel ?? fmt(e.data.date)}
          </span>
        </li>
      ))}
    </ol>
  </section>

  <!-- Completed events -->
  <section class="mx-auto max-w-6xl px-6 py-16">
    <h2 class="h-display reveal mb-8 text-2xl text-white sm:text-3xl">{page.past.titlePrefix} <span class="text-gradient">{page.past.titleAccent}</span></h2>
    <ol class="grid gap-4 sm:grid-cols-2">
      {past.map((e, i) => {
        const tier = podium(e.data.result);
        return (
          <li class="card reveal relative overflow-hidden p-6" style={`--reveal-delay:${i * 80}ms`}>
            {/* checkered-flag corner wash — the "race finished" motif */}
            <div class="pointer-events-none absolute -right-3 -top-3 h-24 w-24 rotate-6 opacity-[0.06]" style="background: repeating-conic-gradient(#fff 0% 25%, transparent 0% 50%) 0 0 / 13px 13px;" aria-hidden="true"></div>

            <div class="relative flex items-center gap-2">
              <span class="inline-flex items-center gap-1.5 rounded-full border border-[#34d399]/35 bg-[#34d399]/12 px-2.5 py-1 font-mono text-[0.58rem] uppercase tracking-[0.22em] text-[#6ee7b7]">
                <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" aria-hidden="true">
                  <path d="M4 2.5v15" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                  <g fill="currentColor">
                    <rect x="6" y="3" width="3" height="3"/><rect x="12" y="3" width="3" height="3"/>
                    <rect x="9" y="6" width="3" height="3"/><rect x="15" y="6" width="1.5" height="3"/>
                    <rect x="6" y="9" width="3" height="3"/><rect x="12" y="9" width="3" height="3"/>
                  </g>
                </svg>
                {page.past.completedLabel}
              </span>
              <span class="font-mono text-xs text-mist">{fmt(e.data.date)}</span>
            </div>

            <h3 class="relative mt-3 font-display text-base font-bold text-white sm:text-lg">{e.data.title}</h3>
            <p class="relative mt-1.5 font-mono text-xs text-mist">{e.data.circuit} · {e.data.series}</p>

            <div class="relative mt-5 flex items-center justify-between gap-4 border-t border-line/60 pt-4">
              {hasResult(e.data.result) ? (
                <span class={`inline-flex items-center gap-1.5 rounded-lg border px-3 py-1.5 font-display text-sm font-bold ${tier ? tierStyle[tier] : 'border-cyan/30 bg-cyan/10 text-cyan'}`}>
                  {tier && (
                    <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <path d="M8 21h8m-4-4v4m5-17H7v4a5 5 0 0 0 10 0V4zm0 1h3v2a3 3 0 0 1-3 3m-7-5H4v2a3 3 0 0 0 3 3" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  )}
                  {e.data.result}
                </span>
              ) : (
                <span class="font-mono text-xs uppercase tracking-[0.2em] text-mist">{page.past.pendingResultLabel}</span>
              )}
              {e.data.link && (
                <a href={e.data.link} class="shrink-0 font-mono text-xs uppercase tracking-[0.2em] text-fog underline-offset-4 transition-colors hover:text-white hover:underline">{page.past.photosLabel}</a>
              )}
            </div>
          </li>
        );
      })}
    </ol>
  </section>

  <script>
    // Countdown to the next event. Digits flip/slide when they change.
    // Re-initialised on every view-transition load; the previous interval is
    // cleared before each swap so it never leaks or double-ticks.
    let cdTimer = 0;

    function initCountdown() {
      const el = document.getElementById('countdown');
      if (!el) return;
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      const target = new Date(el.dataset.date || '').getTime();
      const tba = el.dataset.tba === 'true';
      const note = document.getElementById('countdown-note');
      if (tba && note) note.classList.remove('hidden');

      const units: Record<string, HTMLElement | null> = {
        days: el.querySelector<HTMLElement>('[data-unit="days"]'),
        hours: el.querySelector<HTMLElement>('[data-unit="hours"]'),
        mins: el.querySelector<HTMLElement>('[data-unit="mins"]'),
        secs: el.querySelector<HTMLElement>('[data-unit="secs"]'),
      };

      // Render a value as per-digit flip cells, animating only changed digits.
      function setValue(host: HTMLElement | null, value: string) {
        if (!host) return;
        const chars = value.split('');
        // Rebuild structure if digit count changed.
        if (host.children.length !== chars.length) {
          host.textContent = '';
          chars.forEach((c) => {
            const cell = document.createElement('span');
            cell.className = 'cd-digit';
            const cur = document.createElement('span');
            cur.className = 'cd-cur';
            cur.textContent = c;
            cell.appendChild(cur);
            host.appendChild(cell);
          });
          return;
        }
        chars.forEach((c, i) => {
          const cell = host.children[i] as HTMLElement;
          const cur = cell.querySelector<HTMLElement>('.cd-cur');
          if (!cur || cur.textContent === c) return;
          cur.textContent = c;
          if (reduce) return;
          cell.classList.remove('flip');
          // reflow to allow re-triggering the animation
          void cell.offsetWidth;
          cell.classList.add('flip');
        });
      }

      function tick() {
        const diff = target - Date.now();
        if (Number.isNaN(target) || diff <= 0) {
          setValue(units.days, '0');
          setValue(units.hours, '00');
          setValue(units.mins, '00');
          setValue(units.secs, '00');
          return;
        }
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        setValue(units.days, String(d));
        setValue(units.hours, String(h).padStart(2, '0'));
        setValue(units.mins, String(m).padStart(2, '0'));
        setValue(units.secs, String(s).padStart(2, '0'));
      }

      tick();
      cdTimer = window.setInterval(tick, 1000);
    }

    document.addEventListener('astro:before-swap', () => {
      if (cdTimer) window.clearInterval(cdTimer);
      cdTimer = 0;
    });
    document.addEventListener('astro:page-load', initCountdown);
  </script>
</BaseLayout>
