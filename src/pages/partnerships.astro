---
import BaseLayout from '../layouts/BaseLayout.astro';
import Signature from '../components/Signature.astro';
import site from '../data/site.json';
import page from '../data/pages/partnerships.json';

const { hero, offers, audience, limitBreak, media, partnersSection, deck } = page;
const enquiryHref = `mailto:${site.email}?subject=${encodeURIComponent(hero.ctaPrimarySubject)}`;

// Platform icon paths (same art as SocialLinks).
const platformIcons: Record<string, string> = {
  instagram:
    'M12 2.2c3.2 0 3.6 0 4.9.07 1.2.06 1.8.25 2.2.42.56.22.96.48 1.38.9.42.42.68.82.9 1.38.17.42.36 1.05.42 2.23.06 1.27.07 1.65.07 4.85s0 3.58-.07 4.85c-.06 1.18-.25 1.81-.42 2.23a3.7 3.7 0 0 1-.9 1.38 3.7 3.7 0 0 1-1.38.9c-.42.17-1.05.36-2.23.42-1.27.06-1.65.07-4.85.07s-3.58 0-4.85-.07c-1.18-.06-1.81-.25-2.23-.42a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.17-.42-.36-1.05-.42-2.23C2.2 15.6 2.2 15.2 2.2 12s0-3.58.07-4.85c.06-1.18.25-1.81.42-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.17 1.05-.36 2.23-.42C8.4 2.2 8.8 2.2 12 2.2Zm0 1.8c-3.15 0-3.5 0-4.74.07-1.1.05-1.7.23-2.1.39-.52.2-.9.45-1.29.84-.4.4-.64.77-.84 1.3-.16.4-.34 1-.39 2.1C2.58 9.93 2.57 10.28 2.57 12s.01 2.07.07 3.3c.05 1.1.23 1.7.39 2.1.2.53.44.9.84 1.3.4.4.77.64 1.3.84.4.16 1 .34 2.1.39 1.23.06 1.58.07 4.73.07s3.5-.01 4.74-.07c1.1-.05 1.7-.23 2.1-.39.52-.2.9-.45 1.29-.84.4-.4.64-.77.84-1.3.16-.4.34-1 .39-2.1.06-1.23.07-1.58.07-4.73s-.01-3.5-.07-4.74c-.05-1.1-.23-1.7-.39-2.1a3.5 3.5 0 0 0-.84-1.29c-.4-.4-.77-.64-1.3-.84-.4-.16-1-.34-2.1-.39-1.23-.06-1.58-.07-4.73-.07Zm0 3.06a4.94 4.94 0 1 1 0 9.88 4.94 4.94 0 0 1 0-9.88Zm0 1.8a3.14 3.14 0 1 0 0 6.28 3.14 3.14 0 0 0 0-6.28Zm5.15-3.1a1.15 1.15 0 1 1 0 2.3 1.15 1.15 0 0 1 0-2.3Z',
  youtube:
    'M23.5 6.5s-.23-1.63-.94-2.35c-.9-.94-1.9-.95-2.36-1C16.88 2.9 12 2.9 12 2.9h-.01s-4.88 0-8.2.25c-.46.05-1.46.06-2.36 1-.7.72-.94 2.35-.94 2.35S.25 8.41.25 10.33v1.79c0 1.91.24 3.83.24 3.83s.23 1.63.94 2.35c.9.94 2.08.9 2.6 1 1.89.18 8 .24 8 .24s4.88-.01 8.2-.25c.46-.06 1.47-.07 2.36-1.01.71-.72.94-2.35.94-2.35s.24-1.91.24-3.83v-1.79c0-1.91-.24-3.83-.24-3.83ZM9.56 14.9V8.24l6.4 3.34-6.4 3.32Z',
  tiktok:
    'M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-5.2 1.74 2.89 2.89 0 0 1 2.31-4.64c.3 0 .58.05.86.13V9.4a6.33 6.33 0 0 0-5.39 10.69 6.33 6.33 0 0 0 10.86-4.43v-7a8.16 8.16 0 0 0 4.77 1.53v-3.45a4.85 4.85 0 0 1-.99-.1Z',
};
// The deck is always available at a link (Google Drive/PDF, editable in the CMS).
// Until a link is set, the button gracefully falls back to an email request.
const deckHref = deck.url || `mailto:${site.email}?subject=${encodeURIComponent('Partnership deck')}`;
const deckExternal = Boolean(deck.url);
---
<BaseLayout title={page.meta.title} description={page.meta.description}>
  <!-- Hero -->
  <section class="relative overflow-hidden px-6 pb-20 pt-40 sm:px-12 lg:px-20">
    <!-- Layered media well: a background <video> can drop in as a sibling
         before the image without reworking this markup. -->
    <div class="pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
      <img
        src={hero.image}
        alt=""
        class="parallax absolute inset-0 h-full w-full scale-[1.08] object-cover opacity-25"
        style={`object-position:${hero.imagePosition ?? 'center'}`}
        data-parallax="4"
        data-parallax-scale="1.08"
        loading="eager"
        fetchpriority="high"
        width="1920"
        height="1080"
      />
    </div>
    <div class="absolute inset-0 bg-gradient-to-b from-ink/70 via-ink/85 to-ink" aria-hidden="true"></div>
    <div class="relative">
      <p class="eyebrow reveal mb-4">{hero.eyebrow}</p>
      <h1 class="h-display reveal max-w-4xl text-[clamp(2.6rem,7vw,5.2rem)] uppercase text-white" style="--reveal-delay:100ms">
        {hero.titleLine1}<br /><span class="text-gradient">{hero.titleAccent}</span>
      </h1>
      <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-fog" style="--reveal-delay:220ms">
        {hero.intro}
      </p>
      <div class="reveal mt-9 flex flex-wrap gap-4" style="--reveal-delay:330ms">
        <a href={enquiryHref} class="btn btn-primary">{hero.ctaPrimaryLabel}</a>
        <a href={hero.ctaSecondaryHref} class="btn btn-ghost">{hero.ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>

  <!-- What partners get -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="eyebrow reveal mb-3">{offers.eyebrow}</p>
    <h2 class="h-display reveal text-3xl text-white sm:text-4xl" style="--reveal-delay:80ms">{offers.title}</h2>
    <div class="mt-12 grid gap-5 sm:grid-cols-2">
      {offers.items.map((o, i) => (
        <div class="card reveal p-8" style={`--reveal-delay:${i * 90}ms`}>
          <div class="flex h-12 w-12 items-center justify-center rounded-xl border border-line bg-white/5">
            <svg class="h-6 w-6 stroke-cyan" viewBox="0 0 24 24" fill="none" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d={o.icon}/></svg>
          </div>
          <h3 class="mt-5 font-display text-lg font-bold text-white">{o.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mist">{o.body}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- The audience: platforms + combined reach -->
  <section class="mx-auto max-w-6xl px-6 py-12">
    <p class="eyebrow reveal mb-3">{audience.eyebrow}</p>
    <h2 class="h-display reveal text-3xl text-white sm:text-4xl" style="--reveal-delay:80ms">{audience.title}</h2>

    <div class="grad-border reveal mt-10 overflow-hidden rounded-3xl p-8 text-center sm:p-12" style="--reveal-delay:140ms">
      <p class="font-display text-6xl font-black leading-none text-gradient sm:text-7xl" data-countup={audience.statValue}>{audience.statValue}</p>
      <p class="mx-auto mt-4 max-w-xl text-lg text-fog">{audience.statLabel}</p>
    </div>

    <ul class="mt-6 grid gap-5 sm:grid-cols-3">
      {audience.platforms.map((s, i) => (
        <li class="reveal" style={`--reveal-delay:${i * 90}ms`}>
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="card group flex items-center gap-4 p-6 transition-transform duration-300 hover:-translate-y-1"
          >
            <span class="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl border border-line bg-white/5">
              <svg class="h-6 w-6 fill-fog transition-colors group-hover:fill-white" viewBox="0 0 24 24" aria-hidden="true"><path d={platformIcons[s.platform]}></path></svg>
            </span>
            <span class="min-w-0">
              <span class="block font-display text-base font-bold text-white">{s.label}</span>
              <span class="mt-0.5 block truncate font-mono text-xs text-mist">{s.handle}</span>
              {s.followers && (
                <span class="mt-1 block font-mono text-xs tracking-[0.15em] text-cyan">{s.followers} followers</span>
              )}
            </span>
            <svg class="ml-auto h-4 w-4 shrink-0 stroke-mist transition-all duration-300 group-hover:translate-x-0.5 group-hover:stroke-white" viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Project Limit Break callout -->
  <section class="mx-auto max-w-6xl px-6 py-8">
    <div class="grad-border reveal grid gap-8 overflow-hidden rounded-3xl p-8 sm:p-12 lg:grid-cols-[1.2fr_1fr] lg:items-center">
      <div>
        <p class="eyebrow mb-3">{limitBreak.eyebrow}</p>
        <h2 class="h-display text-2xl text-white sm:text-3xl">{limitBreak.title}</h2>
        <p class="mt-4 leading-relaxed text-fog">
          {limitBreak.body}
        </p>
      </div>
      <img
        src={limitBreak.image}
        alt={limitBreak.imageAlt}
        class="aspect-[4/3] w-full rounded-2xl border border-line object-cover"
        style={`object-position:${limitBreak.imagePosition ?? 'center'}`}
        loading="lazy"
        width="720"
        height="540"
      />
    </div>
  </section>

  <!-- Beyond the track: shoots, podcasts, broadcasts -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="eyebrow reveal mb-3">{media.eyebrow}</p>
    <h2 class="h-display reveal text-3xl text-white sm:text-4xl" style="--reveal-delay:80ms">{media.title}</h2>
    <p class="reveal mt-5 max-w-2xl text-lg text-fog" style="--reveal-delay:160ms">{media.body}</p>

    <div class="mt-12 grid gap-5">
      {media.items.length > 0 && (
        <figure class="reveal">
          <img
            src={media.items[0].image}
            alt={media.items[0].alt}
            class="w-full rounded-2xl border border-line"
            loading="lazy"
            width="1500"
            height="500"
          />
          <figcaption class="mt-3 text-center font-mono text-[0.65rem] uppercase tracking-[0.2em] text-mist">{media.items[0].caption}</figcaption>
        </figure>
      )}
      <div class="grid gap-5 sm:grid-cols-3">
        {media.items.slice(1).map((m, i) => (
          <figure class="reveal" style={`--reveal-delay:${i * 90}ms`}>
            <img
              src={m.image}
              alt={m.alt}
              class="aspect-video w-full rounded-2xl border border-line object-cover"
              loading="lazy"
              width="800"
              height="450"
            />
            <figcaption class="mt-3 text-center font-mono text-[0.65rem] uppercase tracking-[0.2em] text-mist">{m.caption}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- Current partners -->
  <section class="mx-auto max-w-6xl px-6 py-20">
    <p class="eyebrow reveal mb-3">{partnersSection.eyebrow}</p>
    <h2 class="h-display reveal text-3xl text-white sm:text-4xl" style="--reveal-delay:80ms">{partnersSection.title}</h2>
    <ul class="mt-10 grid grid-cols-2 gap-px overflow-hidden rounded-2xl border border-line bg-line sm:grid-cols-4">
      {site.sponsors.map((s, i) => (
        <li class="reveal bg-ink-2" style={`--reveal-delay:${(i % 4) * 70}ms`}>
          <a
            href={s.url}
            class="group flex h-28 items-center justify-center p-6 transition-colors hover:bg-ink-3 sm:h-36"
            aria-label={s.name}
            {...(s.url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
          >
            <img
              src={s.logo}
              alt={`${s.name} logo`}
              loading="lazy"
              width="220"
              height="80"
              class="max-h-14 w-auto max-w-[11rem] object-contain opacity-70 transition-all duration-300 group-hover:-translate-y-0.5 group-hover:opacity-100 sm:max-h-16"
            />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <!-- Signature divider — the animated brand mark re-traces on every visit -->
  <div class="mx-auto max-w-4xl px-6 py-6 text-center" aria-hidden="true">
    <Signature animate glow tone="gradient" class="mx-auto w-[min(70vw,26rem)] opacity-95" />
  </div>

  <!-- Deck CTA -->
  <section id="deck" class="mx-auto max-w-4xl px-6 pb-16 pt-6 text-center">
    <h2 class="h-display reveal text-3xl text-white sm:text-4xl">{deck.title}</h2>
    <p class="reveal mt-4 leading-relaxed text-mist" style="--reveal-delay:100ms">
      {deck.body}
    </p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-4" style="--reveal-delay:200ms">
      <a href={deckHref} class="btn btn-primary" {...(deckExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>{deck.ctaLabel}</a>
      <a href={deck.secondaryHref} class="btn btn-ghost">{deck.secondaryLabel}</a>
    </div>
    <p class="reveal mt-6 font-mono text-xs text-mist" style="--reveal-delay:280ms">{site.email}</p>
  </section>
</BaseLayout>
