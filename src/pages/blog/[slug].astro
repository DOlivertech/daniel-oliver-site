---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TrackMap from '../../components/TrackMap.astro';
import { trackById } from '../../lib/tracks';
import page from '../../data/pages/blog.json';

export async function getStaticPaths() {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((p) => ({ params: { slug: p.id }, props: { post: p } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const track = trackById(post.data.track);
const fmt = post.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });

const abs = (p: string) => new URL(p, Astro.site).href;
const articleLd = {
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.excerpt,
  ...(post.data.cover ? { image: [abs(post.data.cover)] } : {}),
  datePublished: post.data.date.toISOString(),
  dateModified: post.data.date.toISOString(),
  author: { '@type': 'Person', name: 'Daniel Oliver', url: abs('/') },
  publisher: {
    '@type': 'Organization',
    name: 'Daniel Oliver Racing',
    logo: { '@type': 'ImageObject', url: abs('/favicon.png') },
  },
  mainEntityOfPage: abs(Astro.url.pathname),
  ...(post.data.tags?.length ? { keywords: post.data.tags.join(', ') } : {}),
};
---
<BaseLayout
  title={`${post.data.title} — Daniel Oliver Racing`}
  description={post.data.excerpt}
  ogImage={post.data.cover}
  ogImageAlt={post.data.title}
  ogType="article"
  structuredData={[articleLd]}
>
  <article class="pb-24 pt-40">
    <header class="mx-auto max-w-3xl px-6">
      <a href="/blog" class="reveal inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-mist transition-colors hover:text-cyan">
        <svg class="h-4 w-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {page.detail.backLabel}
      </a>

      <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--reveal-delay:80ms">
        <time class="font-mono text-xs text-mist" datetime={post.data.date.toISOString()}>{fmt}</time>
        {post.data.tags.map((t) => (
          <span class="rounded-full border border-line px-3 py-1 font-mono text-[0.62rem] uppercase tracking-widest text-cyan">{t}</span>
        ))}
      </div>

      <h1 class="h-display reveal mt-6 text-[clamp(2rem,5vw,3.6rem)] text-white" style="--reveal-delay:160ms">{post.data.title}</h1>
      <div class="rule-gradient reveal-line mt-8 w-24 opacity-70" style="--reveal-delay:240ms"></div>

      {track && (
        <div class="reveal mt-8 inline-flex items-center gap-4 rounded-2xl border border-line bg-ink-2/40 px-5 py-3.5 backdrop-blur" style="--reveal-delay:320ms">
          {track.path && <TrackMap id={post.data.track} inline class="h-14 w-14 shrink-0 sm:h-16 sm:w-16" />}
          <div class="text-left">
            <p class="font-display text-sm font-bold text-white sm:text-base">
              {track.flag && <span class="mr-1.5 not-italic">{track.flag}</span>}{track.name}
            </p>
            <p class="mt-0.5 font-mono text-[0.6rem] uppercase tracking-[0.25em] text-mist">{track.country || 'Circuit'}</p>
          </div>
        </div>
      )}
    </header>

    {post.data.cover && (
      <figure class="reveal mx-auto mt-12 max-w-4xl px-6" style="--reveal-delay:300ms">
        <img
          src={post.data.cover}
          alt={post.data.title}
          class="aspect-[16/9] w-full rounded-2xl border border-line object-cover"
          loading="eager"
          fetchpriority="high"
          width="1200"
          height="675"
        />
      </figure>
    )}

    <div class="prose-dark mx-auto mt-12 max-w-3xl px-6">
      <Content />
    </div>

    <footer class="mx-auto mt-16 max-w-3xl px-6">
      <div class="grad-border flex flex-col items-start justify-between gap-5 rounded-2xl p-8 sm:flex-row sm:items-center">
        <div>
          <p class="font-display text-lg font-bold text-white">{page.detail.ctaTitle}</p>
          <p class="mt-1 text-sm text-mist">{page.detail.ctaBody}</p>
        </div>
        <a href={page.detail.ctaHref} class="btn btn-primary shrink-0">{page.detail.ctaLabel}</a>
      </div>
    </footer>
  </article>
</BaseLayout>
