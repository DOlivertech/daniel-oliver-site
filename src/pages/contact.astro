---
import BaseLayout from '../layouts/BaseLayout.astro';
import SocialLinks from '../components/SocialLinks.astro';
import page from '../data/pages/contact.json';

const { hero, socialsCard, partnershipCard, form } = page;
---
<BaseLayout title={page.meta.title} description={page.meta.description}>
  <section class="px-6 pb-14 pt-40 sm:px-12 lg:px-20">
    <p class="eyebrow reveal mb-4">{hero.eyebrow}</p>
    <h1 class="h-display reveal text-[clamp(2.6rem,7vw,5.5rem)] uppercase text-white" style="--reveal-delay:100ms">
      {hero.titlePrefix} <span class="text-gradient">{hero.titleAccent}</span>
    </h1>
    <p class="reveal mt-6 max-w-2xl text-lg text-fog" style="--reveal-delay:200ms">
      {hero.intro}
    </p>
  </section>

  <section class="mx-auto max-w-6xl px-6 pb-24">
    <div class="grid gap-10 lg:grid-cols-[1fr_1.3fr]">
      <!-- Direct channels -->
      <div class="flex flex-col gap-6">
        <div class="card reveal p-8">
          <p class="eyebrow mb-4">{socialsCard.eyebrow}</p>
          <SocialLinks />
        </div>

        <div class="grad-border reveal p-8" style="--reveal-delay:200ms">
          <p class="eyebrow mb-3">{partnershipCard.eyebrow}</p>
          <p class="text-sm leading-relaxed text-fog">{partnershipCard.body}</p>
          <a href={partnershipCard.ctaHref} class="btn btn-ghost mt-5">{partnershipCard.ctaLabel}</a>
        </div>
      </div>

      <!-- Netlify form -->
      <form
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        action="/contact?sent=true"
        class="card reveal flex flex-col gap-6 p-8 sm:p-10"
        style="--reveal-delay:150ms"
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hidden">
          <label>Don't fill this out if you're human: <input name="bot-field" /></label>
        </p>

        <div id="form-success" class="hidden rounded-xl border border-cyan/40 bg-cyan/10 px-5 py-4 text-sm text-white" role="status">
          {form.successMessage}
        </div>

        <div class="grid gap-6 sm:grid-cols-2">
          <div class="flex flex-col gap-2">
            <label for="name" class="font-mono text-xs uppercase tracking-[0.25em] text-mist">{form.nameLabel}</label>
            <input required type="text" id="name" name="name" autocomplete="name"
              class="rounded-xl border border-line bg-ink/60 px-4 py-3.5 text-white placeholder:text-mist/60 focus:border-violet focus:outline-none" placeholder={form.namePlaceholder} />
          </div>
          <div class="flex flex-col gap-2">
            <label for="email" class="font-mono text-xs uppercase tracking-[0.25em] text-mist">{form.emailLabel}</label>
            <input required type="email" id="email" name="email" autocomplete="email"
              class="rounded-xl border border-line bg-ink/60 px-4 py-3.5 text-white placeholder:text-mist/60 focus:border-violet focus:outline-none" placeholder={form.emailPlaceholder} />
          </div>
        </div>

        <div class="flex flex-col gap-2">
          <label for="topic" class="font-mono text-xs uppercase tracking-[0.25em] text-mist">{form.topicLabel}</label>
          <select id="topic" name="topic"
            class="rounded-xl border border-line bg-ink/60 px-4 py-3.5 text-white focus:border-violet focus:outline-none">
            {form.topics.map((t) => <option>{t}</option>)}
          </select>
        </div>

        <div class="flex flex-col gap-2">
          <label for="message" class="font-mono text-xs uppercase tracking-[0.25em] text-mist">{form.messageLabel}</label>
          <textarea required id="message" name="message" rows="6"
            class="resize-y rounded-xl border border-line bg-ink/60 px-4 py-3.5 text-white placeholder:text-mist/60 focus:border-violet focus:outline-none" placeholder={form.messagePlaceholder}></textarea>
        </div>

        <button type="submit" class="btn btn-primary self-start">{form.submitLabel}</button>
      </form>
    </div>
  </section>

  <script>
    // Show success note if redirected back with ?sent=true.
    // Runs on each view-transition load so it works after client navigation too.
    function initContactSuccess() {
      if (new URLSearchParams(window.location.search).get('sent') === 'true') {
        document.getElementById('form-success')?.classList.remove('hidden');
      }
    }
    document.addEventListener('astro:page-load', initContactSuccess);
  </script>
</BaseLayout>
