---
import BaseLayout from '../layouts/BaseLayout.astro';
import Signature from '../components/Signature.astro';
import site from '../data/site.json';
import page from '../data/pages/about.json';

const { hero, sections, closing } = page;
---
<BaseLayout title={page.meta.title} description={page.meta.description}>
  <!-- Page hero -->
  <section class="relative overflow-hidden px-6 pb-16 pt-40 sm:px-12 lg:px-20">
    <img src={site.brand.monogram} alt="" aria-hidden="true" class="pointer-events-none absolute -right-14 top-6 h-[38vw] w-auto select-none opacity-[0.05] sm:h-[22vw]" />
    <p class="eyebrow reveal mb-4">{hero.eyebrow}</p>
    <h1 class="h-display reveal max-w-4xl text-[clamp(2.6rem,7vw,5.5rem)] uppercase text-white" style="--reveal-delay:100ms">
      {hero.titleLine1}<br /><span class="text-gradient">{hero.titleAccent}</span>
    </h1>
    <p class="reveal mt-6 max-w-2xl text-lg leading-relaxed text-fog" style="--reveal-delay:220ms">
      {hero.intro}
    </p>
  </section>

  <!-- Narrative sections -->
  {sections.map((s, i) => (
    <section class="mx-auto max-w-6xl px-6 py-16 sm:py-20">
      <div class={`grid items-center gap-10 lg:grid-cols-2 ${i % 2 === 1 ? 'lg:[&>*:first-child]:order-2' : ''}`}>
        <div>
          <div class="grad-border reveal-clip overflow-hidden rounded-2xl">
            <img
              src={s.image}
              alt={s.imageAlt}
              class="parallax aspect-[4/3] w-full scale-[1.08] rounded-2xl object-cover"
              style={`object-position:${s.imagePosition ?? 'center'}`}
              data-parallax="5"
              data-parallax-scale="1.08"
              loading="lazy"
              width="880"
              height="660"
            />
          </div>
          {s.image2 && (
            <div class="grad-border reveal-clip mt-5 overflow-hidden rounded-2xl">
              <img
                src={s.image2}
                alt={s.image2Alt ?? ''}
                class="parallax aspect-[16/10] w-full scale-[1.08] rounded-2xl object-cover"
                style={`object-position:${s.image2Position ?? 'center'}`}
                data-parallax="4"
                data-parallax-scale="1.08"
                loading="lazy"
                width="880"
                height="550"
              />
            </div>
          )}
        </div>
        <div>
          <p class="eyebrow reveal mb-3" style="--reveal-delay:80ms">{s.eyebrow}</p>
          <h2 class="h-display reveal text-3xl text-white sm:text-4xl" style="--reveal-delay:140ms">{s.title}</h2>
          {s.body.map((p, j) => (
            <p class="reveal mt-5 leading-relaxed text-fog" style={`--reveal-delay:${200 + j * 80}ms`}>{p}</p>
          ))}
        </div>
      </div>
    </section>
  ))}

  <!-- Closing CTA -->
  <section class="mx-auto max-w-4xl px-6 py-20 text-center">
    <Signature animate glow tone="gradient" class="mx-auto mb-8 w-[min(72vw,28rem)]" />
    <h2 class="h-display reveal text-3xl text-white sm:text-4xl">{closing.title}</h2>
    <p class="reveal mt-4 text-mist" style="--reveal-delay:100ms">{closing.subtitle}</p>
    <div class="reveal mt-8 flex flex-wrap justify-center gap-4" style="--reveal-delay:200ms">
      <a href={closing.ctaPrimaryHref} class="btn btn-primary">{closing.ctaPrimaryLabel}</a>
      <a href={closing.ctaSecondaryHref} class="btn btn-ghost">{closing.ctaSecondaryLabel}</a>
    </div>
  </section>
</BaseLayout>
