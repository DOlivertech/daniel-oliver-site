---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import page from '../../data/pages/news.json';

export async function getStaticPaths() {
  const items = await getCollection('news', ({ data }) => !data.draft);
  return items.map((n) => ({ params: { slug: n.id }, props: { item: n } }));
}

const { item } = Astro.props;
const { Content } = await render(item);
const fmt = item.data.date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title={`${item.data.title} — Daniel Oliver Racing`}
  description={item.data.excerpt}
  ogImage={item.data.cover}
>
  <article class="pb-24 pt-40">
    <header class="mx-auto max-w-3xl px-6">
      <a href="/news" class="reveal inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-mist transition-colors hover:text-cyan">
        <svg class="h-4 w-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        {page.detail.backLabel}
      </a>

      <div class="reveal mt-8 flex flex-wrap items-center gap-3" style="--reveal-delay:80ms">
        <time class="font-mono text-xs text-mist" datetime={item.data.date.toISOString()}>{fmt}</time>
        {item.data.tags.map((t) => (
          <span class="rounded-full border border-line px-3 py-1 font-mono text-[0.62rem] uppercase tracking-widest text-cyan">{t}</span>
        ))}
      </div>

      <h1 class="h-display reveal mt-6 text-[clamp(2rem,5vw,3.6rem)] text-white" style="--reveal-delay:160ms">{item.data.title}</h1>
      <div class="rule-gradient reveal-line mt-8 w-24 opacity-70" style="--reveal-delay:240ms"></div>
    </header>

    {item.data.cover && (
      <figure class="reveal mx-auto mt-12 max-w-4xl px-6" style="--reveal-delay:300ms">
        <img
          src={item.data.cover}
          alt=""
          class="aspect-[16/9] w-full rounded-2xl border border-line object-cover"
          loading="eager"
          fetchpriority="high"
          width="1200"
          height="675"
        />
      </figure>
    )}

    <div class="prose-dark mx-auto mt-12 max-w-3xl px-6">
      <Content />
    </div>

    {item.data.sourceUrl && (
      <p class="mx-auto mt-10 max-w-3xl px-6 font-mono text-xs text-mist">
        {page.detail.sourcePrefix}{' '}
        <a href={item.data.sourceUrl} target="_blank" rel="noopener noreferrer" class="text-cyan underline-offset-4 hover:underline">
          {item.data.sourceLabel ?? item.data.sourceUrl}
        </a>
      </p>
    )}

    <footer class="mx-auto mt-14 max-w-3xl px-6">
      <div class="grad-border flex flex-col items-start justify-between gap-5 rounded-2xl p-8 sm:flex-row sm:items-center">
        <div>
          <p class="font-display text-lg font-bold text-white">{page.detail.ctaTitle}</p>
          <p class="mt-1 text-sm text-mist">{page.detail.ctaBody}</p>
        </div>
        <a href={page.detail.ctaHref} class="btn btn-primary shrink-0">{page.detail.ctaLabel}</a>
      </div>
    </footer>
  </article>
</BaseLayout>
