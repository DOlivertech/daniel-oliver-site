---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Lightbox from '../../components/Lightbox.astro';
import page from '../../data/pages/media.json';

export async function getStaticPaths() {
  const galleries = await getCollection('galleries');
  return galleries.map((g) => ({ params: { slug: g.id }, props: { gallery: g } }));
}

const { gallery } = Astro.props;
const { title, date, location, images } = gallery.data;
const fmt = date.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<BaseLayout
  title={`${title} — ${page.meta.title}`}
  description={`Photo gallery: ${title} (${images.length} ${page.detail.photosLabel}).`}
  ogImage={gallery.data.cover}
>
  <section class="px-6 pb-12 pt-40 sm:px-12 lg:px-20">
    <a href="/media" class="reveal inline-flex items-center gap-2 font-mono text-xs uppercase tracking-[0.25em] text-mist transition-colors hover:text-cyan">
      <svg class="h-4 w-4 stroke-current" viewBox="0 0 24 24" fill="none" stroke-width="2.4" aria-hidden="true"><path d="M15 6l-6 6 6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
      {page.detail.backLabel}
    </a>
    <h1 class="h-display reveal mt-6 max-w-4xl text-[clamp(2.2rem,5.5vw,4.2rem)] text-white" style="--reveal-delay:100ms">{title}</h1>
    <p class="reveal mt-4 font-mono text-sm text-mist" style="--reveal-delay:180ms">
      {location} · {fmt} · <span class="text-cyan">{images.length} {page.detail.photosLabel}</span>
    </p>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 sm:px-6">
    <div class="gallery-grid">
      {images.map((src, i) => (
        <button
          type="button"
          class="gallery-item reveal-scale group relative block w-full overflow-hidden rounded-xl border border-transparent transition-colors hover:border-violet/40 focus-visible:border-cyan"
          data-lightbox
          data-full={src}
          data-index={i}
          style={`--reveal-delay:${(i % 6) * 60}ms`}
          aria-label={`${page.detail.openPhotoLabel} ${i + 1} / ${images.length}`}
        >
          <span class="gallery-frame block overflow-hidden rounded-xl">
            <img
              src={src}
              alt={`${title} — photo ${i + 1}`}
              loading="lazy"
              decoding="async"
              width="600"
              height="400"
              class="gallery-img h-auto w-full rounded-xl object-cover"
            />
          </span>
          <span class="gallery-overlay pointer-events-none absolute inset-0 rounded-xl" aria-hidden="true"></span>
          <span class="gallery-caption pointer-events-none absolute inset-x-0 bottom-0 flex items-center gap-2 px-4 pb-3 pt-8" aria-hidden="true">
            <span class="font-mono text-[0.6rem] tracking-[0.3em] text-white/90">{String(i + 1).padStart(2, '0')} / {String(images.length).padStart(2, '0')}</span>
            <svg class="ml-auto h-4 w-4 stroke-white/90" viewBox="0 0 24 24" fill="none" stroke-width="2" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-8 8M3 21l8-8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </span>
        </button>
      ))}
    </div>
  </section>

  <Lightbox />

  <style>
    /* Masonry-ish responsive columns */
    .gallery-grid {
      columns: 1;
      column-gap: 1rem;
    }
    @media (min-width: 640px) { .gallery-grid { columns: 2; } }
    @media (min-width: 1024px) { .gallery-grid { columns: 3; } }
    .gallery-item {
      margin-bottom: 1rem;
      break-inside: avoid;
      cursor: zoom-in;
    }
    .gallery-frame { line-height: 0; }
    .gallery-img {
      transition: transform 0.6s var(--ease-out-quint);
      will-change: transform;
    }
    .gallery-item:hover .gallery-img,
    .gallery-item:focus-visible .gallery-img {
      transform: scale(1.055);
    }
    .gallery-overlay {
      background: linear-gradient(
        to top,
        #0b0b14cc 0%,
        #8b5cf61a 40%,
        transparent 70%
      );
      opacity: 0;
      transition: opacity 0.4s var(--ease-out-quint);
    }
    .gallery-item:hover .gallery-overlay,
    .gallery-item:focus-visible .gallery-overlay {
      opacity: 1;
    }
    .gallery-caption {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 0.4s var(--ease-out-quint),
        transform 0.4s var(--ease-out-quint);
    }
    .gallery-item:hover .gallery-caption,
    .gallery-item:focus-visible .gallery-caption {
      opacity: 1;
      transform: none;
    }
    @media (prefers-reduced-motion: reduce) {
      .gallery-img, .gallery-overlay, .gallery-caption { transition: none; }
      .gallery-item:hover .gallery-img { transform: none; }
    }
  </style>
</BaseLayout>
