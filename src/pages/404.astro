---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="404 — Off Track — Daniel Oliver Racing"
  description="This page doesn't exist. Let's get you back on the racing line."
>
  <section class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center">
    <div class="pointer-events-none absolute inset-0 select-none" aria-hidden="true">
      <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-display text-[46vw] font-black leading-none text-white/[0.04] sm:text-[30vw]">404</span>
    </div>

    <!-- racing line skid -->
    <svg class="pointer-events-none absolute inset-x-0 top-1/2 w-full opacity-30" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
      <path d="M-20 90 C200 90 260 30 420 30 S680 100 840 100 1080 40 1220 40" fill="none" stroke="url(#skid-grad)" stroke-width="3" stroke-dasharray="14 10"/>
      <defs>
        <linearGradient id="skid-grad" x1="0" y1="0" x2="1200" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#ff2d87"/><stop offset="0.5" stop-color="#8b5cf6"/><stop offset="1" stop-color="#38bdf8"/>
        </linearGradient>
      </defs>
    </svg>

    <div class="relative">
      <p class="eyebrow mb-5">Error 404</p>
      <h1 class="h-display text-5xl uppercase text-white sm:text-7xl">Off <span class="text-gradient">track</span></h1>
      <p class="mx-auto mt-6 max-w-md text-lg text-fog">
        This page ran wide and found the gravel trap. Every mistake is an experiment — let's rejoin the racing line.
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href="/" class="btn btn-primary">Back to the grid</a>
        <a href="/media" class="btn btn-ghost">Watch the replays</a>
      </div>
    </div>
  </section>
</BaseLayout>
