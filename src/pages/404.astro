---
import BaseLayout from '../layouts/BaseLayout.astro';
import page from '../data/pages/notfound.json';
---
<BaseLayout title={page.meta.title} description={page.meta.description}>
  <section class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden px-6 text-center">
    <div class="pointer-events-none absolute inset-0 select-none" aria-hidden="true">
      <span class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 font-display text-[46vw] font-black leading-none text-white/[0.04] sm:text-[30vw]">{page.ghostText}</span>
    </div>

    <!-- racing line skid -->
    <svg class="pointer-events-none absolute inset-x-0 top-1/2 w-full opacity-30" viewBox="0 0 1200 120" preserveAspectRatio="none" aria-hidden="true">
      <path class="skid-path" d="M-20 90 C200 90 260 30 420 30 S680 100 840 100 1080 40 1220 40" fill="none" stroke="url(#skid-grad)" stroke-width="3"/>
      <defs>
        <linearGradient id="skid-grad" x1="0" y1="0" x2="1200" y2="0" gradientUnits="userSpaceOnUse">
          <stop stop-color="#ff2d87"/><stop offset="0.5" stop-color="#8b5cf6"/><stop offset="1" stop-color="#38bdf8"/>
        </linearGradient>
      </defs>
    </svg>

    <div class="relative">
      <div class="relative">
        <p class="eyebrow mb-5">{page.eyebrow}</p>
        <h1 class="relative z-[2] h-display text-5xl uppercase text-white sm:text-7xl">{page.titlePrefix} <span class="text-gradient">{page.titleAccent}</span></h1>

        <!-- chibi Daniel lapping the headline (same orbit as /store, tighter) -->
        <div class="orbit404 pointer-events-none absolute left-1/2 top-[55%]" aria-hidden="true">
          <div class="orbit404-x">
            <div class="orbit404-y">
              <img src="/images/store/chibi-daniel.webp" alt="" width="675" height="910" class="chibi404" loading="eager" />
            </div>
          </div>
        </div>
      </div>

      <p class="mx-auto mt-6 max-w-md text-lg text-fog">
        {page.body}
      </p>
      <div class="mt-9 flex flex-wrap justify-center gap-4">
        <a href={page.ctaPrimaryHref} class="btn btn-primary">{page.ctaPrimaryLabel}</a>
        <a href={page.ctaSecondaryHref} class="btn btn-ghost">{page.ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>

  <style>
    /* -- orbiting chibi: X/Y half out of phase → ellipse; z flips behind the
       heading across the top of the lap (mirrors the /store treatment) ---- */
    .orbit404 {
      --rx: min(34vw, 300px);
      --ry: clamp(48px, 10vh, 84px);
      --chibi-w: clamp(72px, 12vw, 118px);
      animation: orbit404-z 14s infinite;
      z-index: 3;
    }
    .orbit404-x { animation: orbit404-x 7s ease-in-out infinite alternate; }
    .orbit404-y { animation: orbit404-y 7s ease-in-out infinite alternate; animation-delay: -3.5s; }
    .chibi404 {
      width: var(--chibi-w);
      height: auto;
      margin-left: calc(var(--chibi-w) / -2);
      filter: drop-shadow(0 10px 16px rgba(0, 0, 0, 0.45));
      animation:
        orbit404-depth 14s ease-in-out infinite,
        chibi404-bob 3s ease-in-out infinite alternate;
    }
    @keyframes orbit404-x {
      from { transform: translateX(calc(var(--rx) * -1)); }
      to   { transform: translateX(var(--rx)); }
    }
    @keyframes orbit404-y {
      from { transform: translateY(var(--ry)); }
      to   { transform: translateY(calc(var(--ry) * -1)); }
    }
    @keyframes orbit404-depth {
      0%   { scale: 1; }
      25%  { scale: 0.78; }
      50%  { scale: 1; }
      75%  { scale: 1.1; }
      100% { scale: 1; }
    }
    @keyframes orbit404-z {
      0%, 12.5%  { z-index: 3; }
      12.51%, 37.5% { z-index: 1; }
      37.51%, 100% { z-index: 3; }
    }
    @keyframes chibi404-bob {
      from { transform: translateY(0) rotate(-3deg); }
      to   { transform: translateY(-7px) rotate(3deg); }
    }
    @media (prefers-reduced-motion: reduce) {
      .orbit404 { display: none; }
    }

    .skid-path {
      stroke-dasharray: var(--skid-len, 1600);
      stroke-dashoffset: var(--skid-len, 1600);
    }
    .skid-path.drawn {
      transition: stroke-dashoffset 1.8s var(--ease-out-quint);
      stroke-dashoffset: 0;
    }
    @media (prefers-reduced-motion: reduce) {
      .skid-path { stroke-dashoffset: 0; }
      .skid-path.drawn { transition: none; }
    }
  </style>

  <script>
    // Draw the skid line on load (and after view-transition swaps).
    function initSkid() {
      const path = document.querySelector<SVGPathElement>('.skid-path');
      if (!path) return;
      const reduce = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;
      let len = 1600;
      try {
        len = path.getTotalLength() || 1600;
      } catch {}
      path.style.setProperty('--skid-len', String(len));
      if (reduce) return;
      path.classList.remove('drawn');
      void path.getBoundingClientRect();
      requestAnimationFrame(() =>
        requestAnimationFrame(() => path.classList.add('drawn'))
      );
    }
    document.addEventListener('astro:page-load', initSkid);
  </script>
</BaseLayout>
